# RabbitScout image and published port (Docker Compose)
RABBITSCOUT_IMAGE=rabbitscout:zh-cn
RABBITSCOUT_PORT=3000

# RabbitMQ Connection
# Use host.docker.internal when RabbitScout runs in a container on Docker Desktop.
# Use the host's LAN IP when RabbitMQ runs on another machine.
# Use localhost only when RabbitScout runs directly on the host (npm run dev).
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=15672
RABBITMQ_PROTOCOL=http

# Optional: API request timeout in milliseconds (default: 15000)
# RABBITMQ_API_TIMEOUT_MS=15000

# Optional: force the session cookie's Secure attribute on or off.
# By default RabbitScout detects HTTPS per-request (x-forwarded-proto aware),
# so you only need this if a proxy hides the original protocol.
# COOKIE_SECURE=true

# Note: Username and password are no longer configured here.
# Each user authenticates with their own RabbitMQ credentials via the login page.
