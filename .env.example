# HainMQ Console image and published port (Docker Compose)
HAINMQ_IMAGE=hainmq-console:2.1.2
HAINMQ_PORT=3000

# RabbitMQ Connection
# Use host.docker.internal when HainMQ Console runs in a container on Docker Desktop.
# Use the host's LAN IP when RabbitMQ runs on another machine.
# Use localhost only when HainMQ Console runs directly on the host (npm run dev).
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=15672
RABBITMQ_PROTOCOL=http

# Optional: display name for the default single cluster.
# RABBITMQ_CLUSTER_NAME=Default

# Optional: multiple RabbitMQ Management endpoints. When set, the login page
# and header show a cluster selector. Each entry needs a unique id and host.
# RABBITMQ_CLUSTERS=[{"id":"prod","name":"Production","host":"rabbitmq-prod","port":"15672","protocol":"http"},{"id":"staging","name":"Staging","host":"rabbitmq-staging","port":"15672","protocol":"http"}]

# Optional: API request timeout in milliseconds (default: 15000)
# RABBITMQ_API_TIMEOUT_MS=15000

# Optional: force the session cookie's Secure attribute on or off.
# By default HainMQ Console detects HTTPS per-request (x-forwarded-proto aware),
# so you only need this if a proxy hides the original protocol.
# COOKIE_SECURE=true

# Optional: require two different operators for write approvals.
# OPS_TWO_PERSON_APPROVAL=false

# Optional: retention for audit logs and SQLite backups.
# OPS_AUDIT_RETENTION_DAYS=365
# OPS_BACKUP_RETENTION_DAYS=7

# Optional: bearer token for GET /api/metrics. Leave empty to allow unauthenticated scrapes.
# OPS_METRICS_TOKEN=

# Note: Username and password are no longer configured here.
# Each user authenticates with their own RabbitMQ credentials via the login page.
