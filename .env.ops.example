# Public branding (runtime, no rebuild needed after changing these)
APP_NAME=海心云
APP_PRODUCT_NAME=RabbitMQ 管理台
APP_COPYRIGHT=© 2026 海心云
APP_LICENSE=MIT
APP_LICENSE_URL=https://github.com/cn-cam/RabbitScout/blob/main/LICENSE
APP_ATTRIBUTION=Based on RabbitScout (MIT)
APP_ATTRIBUTION_URL=https://github.com/Ralve-org/RabbitScout
APP_LOGO_URL=/images/logo.png

# RabbitMQ connection used by the web app and the default monitoring target
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=15672
RABBITMQ_PROTOCOL=http

# Dedicated read-only RabbitMQ account for background monitoring.
# Create a user with the "monitoring" tag and only the vhost permissions it needs.
OPS_RABBITMQ_USERNAME=rabbitscout-monitor
OPS_RABBITMQ_PASSWORD=change-me

# Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this value out of Git. Losing it requires re-entering stored secrets.
OPS_ENCRYPTION_KEY=

# MCP bearer token used by local opencode. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPS_MCP_TOKEN=

# Write tools are available, but every write still requires approval in /ops/approvals.
# Set to false to remove write access entirely.
OPS_MCP_ALLOW_WRITE=true
OPS_MCP_ALLOWED_VHOSTS=/
OPS_MCP_QUEUE_PREFIXES=
OPS_MCP_RATE_LIMIT_PER_MINUTE=60
OPS_MCP_MAX_MESSAGES=10
# Message peeking exposes payloads to the model. Keep false unless needed.
OPS_MCP_ALLOW_PEEK=false

# Operations module settings
OPS_DB_PATH=/app/data/ops.db
OPS_POLL_INTERVAL_MS=60000
OPS_SAMPLE_RETENTION_DAYS=30
OPS_ALERT_RETENTION_DAYS=180
OPS_NOTIFICATION_RETENTION_DAYS=90
OPS_TIMEZONE=Asia/Shanghai
# Only these RabbitMQ administrators can manage ops. Empty means all administrators.
OPS_ADMIN_USERS=administrator
OPS_WEBHOOK_ALLOW_PRIVATE=false
# Enable/disable the operations chat page.
OPS_CHAT_ENABLED=true
OPS_COLLECTOR_TIMEOUT_MS=15000
OPS_MODEL_TIMEOUT_MS=120000
